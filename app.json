{
  "expo": {
    "name": "Up2Date",
    "slug": "Up2Date",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "up2date",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1528"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.up2date.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Up2Date uses your location to show news from your city and region."
      }
    },
    "android": {
      "package": "com.up2date.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#0D1528",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Up2Date uses your location to show news from your city and region."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "defaultAiBaseUrl": "",
      "eas": {}
    }
  }
}
